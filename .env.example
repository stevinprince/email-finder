# ── email-finder environment variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Step 5 (third-party verification API) ─────────────────────────────────────
# Uncomment and set whichever service you use.

# Hunter.io API key  (https://hunter.io/api)
# HUNTER_API_KEY=your_key_here

# NeverBounce API key  (https://neverbounce.com/api)
# NEVERBOUNCE_API_KEY=your_key_here

# ZeroBounce API key  (https://www.zerobounce.net/api)
# ZEROBOUNCE_API_KEY=your_key_here

# ── Optional: Clearbit Autocomplete (domain resolution, Step 2) ───────────────
# CLEARBIT_API_KEY=your_key_here
